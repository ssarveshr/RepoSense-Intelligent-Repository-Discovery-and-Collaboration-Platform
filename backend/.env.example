# Backend environment variables (copy to backend/.env)

# Database — SQLite only for now (PostgreSQL not yet supported/tested)
DATABASE_URL=sqlite+aiosqlite:///./reposense.db

# LiveKit Cloud (required for real calls; provides STUN/TURN automatically — Phase 4)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Clerk — required for authenticated meeting creation and profile endpoints
# JWKS URL from Clerk Dashboard → API Keys → Advanced → JWKS URL
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Issuer from Clerk Dashboard (Frontend API URL)
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional audience claim when Clerk session tokens include aud
# CLERK_AUDIENCE=

# CORS — comma-separated origins (defaults to http://localhost:5173 for local Vite dev)
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# SMTP (optional — meeting invitation emails; deployment-time configuration only)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Public frontend URL for invitation join links (production)
# FRONTEND_BASE_URL=https://app.example.com

# GitHub token (optional — collaborator listing for private repos / higher rate limits)
# GITHUB_TOKEN=

# GitHub OAuth (per-user connection; client secret stays backend-only)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback
# GITHUB_TOKEN_ENCRYPTION_KEY=

# Diagnostics — disabled by default (never log tokens or secrets when enabled)
# AUTH_DIAGNOSTICS=false
# GITHUB_DIAGNOSTICS=false
