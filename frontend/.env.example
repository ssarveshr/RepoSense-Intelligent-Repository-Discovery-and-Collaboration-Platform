# Frontend environment variables (copy to frontend/.env)

# Public backend URL for all RepoSense API requests.
# For local-only dev (default when unset):
VITE_API_BASE_URL=http://localhost:8000

# For Cloudflare Quick Tunnel public dev — copy URL from:
#   cloudflared tunnel --url http://localhost:8000
# Update whenever the backend Quick Tunnel restarts (URLs are temporary):
# VITE_API_BASE_URL=https://yyyy.trycloudflare.com

# Optional fallback LiveKit URL — join API also returns livekit_url per session.
# Media connects directly to LiveKit Cloud (do NOT tunnel LiveKit):
VITE_LIVEKIT_URL=wss://reposense-meetings-18f7x8bu.livekit.cloud

# Optional — Clerk authentication (https://dashboard.clerk.com)
# Add current frontend Quick Tunnel URL to Clerk allowed origins when it changes.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
