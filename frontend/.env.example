# Frontend environment variables (copy to frontend/.env)
# Vite reads VITE_* values at `npm run dev` / `npm run build` startup.
# Restart `npm run dev` after changing them. Production builds embed
# VITE_* values at build time; changing them later requires a rebuild.

# Public backend URL for all RepoSense API requests (required for production builds).
# Local development example (also the DEV-only default when unset):
VITE_API_BASE_URL=http://localhost:8000

# Public / Quick Tunnel deployments: copy the live backend origin into this variable.
# Do not put a Cloudflare Quick Tunnel URL in this example or in source.
# Quick Tunnel URLs change whenever the tunnel is recreated.

# Optional public frontend origin for shareable meeting join links.
# When unset, the current browser origin is used.
# VITE_FRONTEND_BASE_URL=http://localhost:5173

# Optional fallback LiveKit URL — join API also returns livekit_url per session.
# Media connects directly to LiveKit Cloud (do NOT tunnel LiveKit):
VITE_LIVEKIT_URL=wss://reposense-meetings-18f7x8bu.livekit.cloud

# Optional — Clerk authentication (https://dashboard.clerk.com)
# Add the current frontend origin to Clerk allowed origins when it changes.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
